# =====================================================================
#  SAMC Invent — variables d'environnement
#  Copier ce fichier en « .env » à la racine du projet (dev/samc-invent/.env)
#  En production, renseigner les mêmes variables dans Vercel › Settings › Environment Variables
# =====================================================================

# --- Base de données PostgreSQL --------------------------------------
# Vide  → base PostgreSQL embarquée (PGlite) dans server/data/pglite : aucune installation
# Supabase local (npx supabase start) :
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase cloud (Project Settings › Database › Connection string › « Transaction pooler », port 6543) :
#   DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Projet SAMC (samcassos, eu-west-1) : ref = cmjcczkbwervaptlginq — copier la chaîne exacte depuis le bouton « Connect »
DATABASE_URL=

# --- Photos : Supabase Storage (optionnel en local) ------------------
# Vide → photos stockées sur le disque (server/data/uploads)
# Supabase local : SUPABASE_URL=http://127.0.0.1:54321 et la clé « service_role » affichée par « npx supabase status »
# Projet SAMC : SUPABASE_URL=https://cmjcczkbwervaptlginq.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=photos

# --- Sécurité --------------------------------------------------------
# Secret de signature des sessions (obligatoire en production). Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Compte administrateur créé au premier démarrage si la base est vide
ADMIN_EMAIL=admin@samc.local
ADMIN_PASSWORD=admin1234

# --- Serveur local ---------------------------------------------------
PORT=3000
