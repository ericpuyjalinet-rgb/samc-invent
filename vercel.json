{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "regions": [
    "dub1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "supabase/migrations/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/mobile",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/mobile/:path*",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/:path((?!api/|mobile/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/mobile/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/mobile/"
        }
      ]
    },
    {
      "source": "/(assets|mobile/assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
